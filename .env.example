# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# --- Postgres ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mygymtracker

# --- Object storage (RustFS, S3-compatible; console on S3_CONSOLE_PORT) ---
S3_ACCESS_KEY=gym-s3
S3_SECRET_KEY=change-me-s3
# Bucket for uploaded PDFs and Apple Health exports (created on startup)
S3_BUCKET=mygymtracker

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Signs access tokens and password-reset links. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Secure cookies need HTTPS; keep false only for local http development.
COOKIE_SECURE=false
# Base URL of the frontend, used in the links of the emails.
FRONTEND_URL=http://localhost:5173
# Testing on a phone through a tunnel (ngrok): the dev server's extra host names, comma-separated.
#   ngrok http --url=https://your-name.ngrok-free.app 5173
DEV_ALLOWED_HOSTS=

# --- LLM (reads imported workout PDFs) ---
# The PDF's text is sent to this provider. Any OpenAI-compatible API works;
# the defaults point at DeepSeek (https://platform.deepseek.com/api_keys).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# --- Web Push notifications (VAPID) ---
# Generate once and keep it: a new key invalidates every device's subscription.
#   docker compose exec backend python -m app.notifications.keys
VAPID_PRIVATE_KEY=
# A contact for the push services (mailto: or https:).
VAPID_SUBJECT=mailto:admin@mygymtracker.local

# --- Host ports (bound to 127.0.0.1; change if they clash with other projects) ---
FRONTEND_PORT=5173
BACKEND_PORT=8200
POSTGRES_PORT=5440
S3_API_PORT=9100
S3_CONSOLE_PORT=9101
MAILPIT_UI_PORT=8026
