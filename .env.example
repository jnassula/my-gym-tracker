# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# --- Postgres ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mygymtracker

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=gym-minio
MINIO_ROOT_PASSWORD=change-me-minio

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Host ports (bound to 127.0.0.1; change if they clash with other projects) ---
FRONTEND_PORT=5173
BACKEND_PORT=8200
POSTGRES_PORT=5440
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
