# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# --- Postgres ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mygymtracker

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=gym-minio
MINIO_ROOT_PASSWORD=change-me-minio

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Signs access tokens and password-reset links. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Secure cookies need HTTPS; keep false only for local http development.
COOKIE_SECURE=false
# Base URL of the frontend, used in password-reset emails.
FRONTEND_URL=http://localhost:5173

# --- Host ports (bound to 127.0.0.1; change if they clash with other projects) ---
FRONTEND_PORT=5173
BACKEND_PORT=8200
POSTGRES_PORT=5440
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MAILPIT_UI_PORT=8026
