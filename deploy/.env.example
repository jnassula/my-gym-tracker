# Production settings. On the server: copy to .env next to compose.yml, fill in, chmod 600.
# Never commit the real file. Generate each password/secret with:  openssl rand -hex 32
# See README.md in this folder.

# --- Site ---
# The public host name. Its DNS A (and AAAA) record points at the server; Caddy gets the
# certificate on the first start. localhost runs the stack on your machine (local CA).
DOMAIN=gym.example.com

# --- Images ---
IMAGE_REPOSITORY=ghcr.io/jnassula/my-gym-tracker
# The commit that is live. deploy.sh writes it; leave empty on a new server.
IMAGE_TAG=

# --- Postgres ---
POSTGRES_USER=gym
POSTGRES_PASSWORD=
POSTGRES_DB=mygymtracker

# --- Object storage (RustFS: the imported PDFs; never exposed outside the server) ---
S3_ACCESS_KEY=gym-s3
S3_SECRET_KEY=
S3_BUCKET=mygymtracker

# --- Backend ---
LOG_LEVEL=INFO
# Signs sessions and password-reset links. Changing it signs everyone out.
JWT_SECRET=

# --- Email (password recovery): your provider's SMTP, port 587 with STARTTLS ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=myGymTracker <no-reply@gym.example.com>

# --- Backoffice (/admin): the accounts that may open it, comma-separated. Create the account
# in the app first: an address listed here can no longer be registered. Empty: nobody.
ADMIN_EMAILS=

# --- LLM that reads imported PDFs (empty: importing answers 503, the rest works) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# --- Web Push. Generate once after the first deploy and keep it forever:
#   docker compose exec backend python -m app.notifications.keys
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:… or the site's own https:// address.
VAPID_SUBJECT=https://gym.example.com

# --- Backups in ./backups: every day at this hour (UTC), kept this many days ---
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14

# --- Published ports (change only next to another web server, or on your machine) ---
HTTP_PORT=80
HTTPS_PORT=443
